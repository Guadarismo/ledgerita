[Unit]
Description=Ledgerita Protocol Core Node (TestNet)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/ledgerita_core
ExecStart=/home/user/ledgerita_core/target/release/ledgerita_core --network testnet --data-dir /home/user/.ledgerita-testnet --listen-port 46565
EnvironmentFile=/etc/ledgerita/env
Restart=always
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
